UUID1 = "63d138a7-e4f3-4950-8ea4-0b03add5dd9a"

def test_template_url_replaces_identifiers():
  assert template_url(f"https://api.example.com/v1/tasks/{UUID1}/progresses") \
    == "api.example.com/v1/tasks/{id}/progresses"
  assert template_url("https://canvas.example.com/courses/63874/assignments/1") \
    == "canvas.example.com/courses/{n}/assignments/{n}"
  assert template_url(f"https://eu.example.com/courses/lti%2Fcourse/{UUID1}") \
    == "eu.example.com/courses/lti%2Fcourse/{id}"

def test_template_url_hides_odd_segments():
  assert template_url("https://x.example.com/people/alice@example.com") \
    == "x.example.com/people/{x}"
  assert template_url("https://x.example.com/v1/" + "ab12" * 8) \
    == "x.example.com/v1/{hex}"
  assert template_url("https://x.example.com/thumbnails/1/HCZFs5GRoRvQv") \
    == "x.example.com/thumbnails/{n}/{x}"
