The arguments are registered by a function of their own, so that the
standalone command and [[canvaslms]] share them.

<<functions>>=
def add_command(subp):
    """Add the `har-shape` and `har-diff` commands to `subp`."""
    shape_parser = subp.add_parser(
        "har-shape", help="Print the shape (names, no values) of HAR files")
    shape_parser.add_argument("har", nargs="+", help="HAR file(s)")
    shape_parser.add_argument(
        "-u", "--update", metavar="SHAPE", nargs="?", const=REFERENCE_SHAPE,
        help="merge into this shape file instead of printing, "
             f"default {REFERENCE_SHAPE}")
    shape_parser.set_defaults(func=har_shape_command)

    diff_parser = subp.add_parser(
        "har-diff", help="Compare a HAR capture with the reference shape")
    diff_parser.add_argument("har", nargs="+", help="HAR file(s)")
    diff_parser.add_argument(
        "-r", "--reference", default=REFERENCE_SHAPE,
        help=f"reference shape file, default {REFERENCE_SHAPE}")
    diff_parser.set_defaults(func=har_diff_command)
