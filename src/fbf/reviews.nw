def parse(*arguments):
  parser = argparse.ArgumentParser(prog="fbf")
  add_command(parser.add_subparsers())
  return parser.parse_args(["reviews", *arguments])

def test_add_command_parses_the_views_and_refuses_two():
  args = parse("-l", "--feedback")
  assert (args.long, args.feedback, args.reflections, args.json) \
    == (True, True, False, False)
  assert args.func is reviews_command
  with pytest.raises(SystemExit):
    parse("--feedback", "--reflections")
