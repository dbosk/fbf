  assert [len(row) for row in rows(REVIEWS, view())] == [7, 7]
  assert [len(row) for row in rows(REVIEWS, view(long=True))] == [9, 9, 9]
  assert list(rows([Feedback("E", "Ada", "Bo", 4, "")],
