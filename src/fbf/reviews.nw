\section{Examples for the contract test}

The contract test of \cref{Schema} needs an example of every type declared
above.
They all hang off the tasks of peer-feedback activities, but the launched
activity is a video, so the fetchers search the activities of the launched
course whose [[tool]] is [[peerfeedback]], in the order FBF lists them,
until they find the type.
The first peer review in our course has comment criteria only, and
feedback exists only where it is enabled, so the search may
take a few activities; it skips those where feedback is off, which would
otherwise cost a request per allocation for nothing.
The lists behind the allocations are fetched lazily, one allocation at a
time, so that a search stops at the first example rather than fetching an
activity's 800 lists.
A type that cannot be found raises with its name.
Activities and users are declared by \cref{Discussions} too, and their
fetchers are there.
These chunks are tangled into [[conftest.py]] with the fetchers of the other
chapters, hence the import and the prefixed names.

<<example fetchers>>=
from fbf import reviews as review


def review_task_sets(fbf, login):
    """Yield the tasks of the peer reviews in the launched course."""
    for activity in fbf.get(
            f"v1/courses/{login.course_uuid}/activities").resources:
        if (activity.get("attributes") or {}).get("tool") == "peerfeedback":
            tasks = review.peer_review_tasks(fbf, activity["id"])
            if tasks:
                yield tasks


def review_example(fbf, login, kind, resources_of):
    """Return the first resource of `kind` among `resources_of` some tasks."""
    for tasks in review_task_sets(fbf, login):
        for resource in resources_of(fbf, tasks):
            if resource["type"] == kind:
                return resource
    raise LookupError(f"no {kind} in the launched course")


def review_list(name, task=review.REVIEW_TASK):
    """Return a function listing the relationship `name` of a task."""
    return lambda fbf, tasks: (fbf.get(review.related_link(tasks[task],
                                                           name)).resources
                               if task in tasks else [])


def review_allocation_list(name, has_any, only_if=lambda tasks: True):
    """Return a function listing `name` of each allocation, lazily.

    Tasks for which `only_if` is false are not searched.
    """
    def resources(fbf, tasks):
        if not only_if(tasks):
            return
        for allocation in review_list("allocations")(fbf, tasks):
            if has_any(allocation):
                yield from fbf.get(review.related_link(allocation,
                                                       name)).resources
    return resources


def review_options(fbf, tasks):
    """List the options of the rubric criteria of a review task."""
    criteria = review_list("criteria")(fbf, tasks)
    return fbf.get_by_ids("v1/assignments/criterion_options",
                          [r["id"] for c in criteria
                           for r in c["relationships"]["options"]["data"]
                           or []]).values()


for kind in [review.REVIEW_TASK, review.VIEW_TASK, review.REFLECT_TASK]:
    example(kind)(lambda fbf, login, kind=kind:
                  review_example(fbf, login, kind,
                                 lambda fbf, tasks: tasks.values()))

example("assignments/allocation")(
    lambda fbf, login: review_example(fbf, login,
                                         "assignments/allocation",
                                         review_list("allocations")))

for kind in review.CRITERION_TYPES:
    example(kind)(lambda fbf, login, kind=kind:
                  review_example(fbf, login, kind,
                                 review_list("criteria")))

example("assignments/criterion-option")(
    lambda fbf, login: review_example(fbf, login,
                                         "assignments/criterion-option",
                                         review_options))

for kind, name, has_any in [
        ("reviews", "reviews", review.counted("reviews-count")),
        ("ratings", "ratings", review.counted("ratings-count"))]:
    example(kind)(lambda fbf, login, kind=kind, name=name,
                  has_any=has_any:
                  review_example(fbf, login, kind,
                                 review_allocation_list(name, has_any)))

example("reviewer-feedbacks")(
    lambda fbf, login: review_example(
        fbf, login, "reviewer-feedbacks",
        review_allocation_list("reviewer-feedback", review.reviewed,
                               review.feedback_enabled)))

example("reflections")(
    lambda fbf, login: review_example(
        fbf, login, "reflections",
        review_list("reflections", review.REFLECT_TASK)))
