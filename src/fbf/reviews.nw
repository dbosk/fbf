def test_make_reviews_joins_levels_and_comments():
  allocations = [allocation("a1", "u1", "u2"), allocation("a2", "u3", "u2"),
                 allocation("a3", "u2", "u3", reviews=0, ratings=0)]
  reviews = [review("r2", "a1", "c2", "Later", "2026-10-02T10:00Z",
                    parent="assignments/submission"),
             review("r1", "a1", "c2", "First", "2026-10-01T10:00Z"),
             review("r3", "a1", "c1", "Clear!", "2026-10-01T11:00Z")]
  ratings = [rating("s1", "a1", "c1", "o1"), rating("s2", "a2", "c1", "o0")]
  result = make_reviews("Essay", list(reversed(allocations)), reviews,
                        ratings, CRITERIA, OPTIONS, USERS)
  assert [(r.reviewee, r.reviewer, r.criterion, r.level, r.score,
           [c.body for c in r.comments]) for r in result] == [
    ("Ada", "Bo", "Clarity", "Clear", 1, ["Clear!"]),
    ("Ada", "Bo", "Overall", "", None, ["First", "Later"]),
    ("Ada", "Cy", "Clarity", "Unclear", 0, [])]
  assert [c.on for c in result[1].comments] == ["activity", "submission"]
  assert {r.activity for r in result} == {"Essay"}
