The views exclude each other, which [[argparse]] enforces.
[[--long]] concerns only the reviews.

<<functions>>=
def add_command(subp):
    """Add the `reviews` command to `subp`."""
    parser = subp.add_parser(
        "reviews",
        help="List the peer reviews of FBF peer-feedback activities",
        description="List the peer reviews of FeedbackFruits peer-feedback "
                    "activities: activity, reviewee, reviewer, criterion, "
                    "level, score and comments; or the reviewees' feedback "
                    "on the reviews, or the reflections.")
    canvaslms.cli.assignments.add_assignment_option(parser, ungraded=False)
    parser.add_argument("-l", "--long", action="store_true",
                        help="one row per comment instead of per criterion: "
                             "adds what it is on and when it was written")
    view = parser.add_mutually_exclusive_group()
    view.add_argument("--feedback", action="store_true",
                      help="list the reviewees' ratings of the reviews: "
                           "activity, reviewee, reviewer, rating, text")
    view.add_argument("--reflections", action="store_true",
                      help="list the reflections: activity, student, text")
    parser.add_argument("--json", action="store_true",
                        help="print as JSON, reviews with their comments")
    parser.set_defaults(func=reviews_command)
@

