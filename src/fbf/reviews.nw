The helper [[ref]] makes the bare references that FBF uses between them.

<<test functions>>=
def ref(kind, id):
  return {"data": {"type": kind, "id": id}}

def allocation(id, reviewer="u1", reviewee="u2", reviews=1, ratings=1,
               actor_type="users"):
  return {"type": "assignments/allocation", "id": id,
          "attributes": {"reviews-count": reviews, "ratings-count": ratings},
          "relationships": {"actor": ref(actor_type, reviewer),
                            "allocable": ref("users", reviewee),
                            "reviews": {"links": {"related": f"/r/{id}"}},
                            "ratings": {"links": {"related": f"/s/{id}"}},
                            "reviewer-feedback": {
                              "links": {"related": f"/f/{id}"}}}}

def test_person_reads_users_and_refuses_groups():
  assert person(allocation("a"), "actor") == "u1"
  assert person(allocation("a"), "allocable") == "u2"
  with pytest.raises(UnknownTypeError, match="'groups'"):
    person(allocation("a", actor_type="groups"), "actor")

def test_check_criteria_refuses_unknown_types():
  check_criteria([{"type": "assignments/criterion"},
                  {"type": "assignments/rubric-criterion"}])
  with pytest.raises(UnknownTypeError, match="scale-criterion"):
    check_criteria([{"type": "assignments/scale-criterion"}])
