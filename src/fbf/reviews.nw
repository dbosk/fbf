             Comment("activity", "t1", "Fine\nwork"),
             Comment("submission", "t2", "Typo")]),
           Review("Essay", "Ada", "Cy", "Clarity", "Clear", 1)]

def test_review_rows_short_and_long():
  assert list(review_rows(REVIEWS)) == [
    ["Essay", "Ada", "Bo", "Overall", "", "", "Fine work | Typo"],
    ["Essay", "Ada", "Cy", "Clarity", "Clear", "1", ""]]
  assert [row[2:] for row in review_rows(REVIEWS, long=True)] == [
    ["Bo", "Overall", "", "", "activity", "t1", "Fine work"],
    ["Bo", "Overall", "", "", "submission", "t2", "Typo"],
    ["Cy", "Clarity", "Clear", "1", "", "", ""]]
