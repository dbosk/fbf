\section{Reflections}

The reflections are one list behind the reflect task.
Their authors are bare references, and the endpoint ignores
[[include=user]], so we fetch the users by id.

<<functions>>=
def fetch_reflections(fbf, tasks, activity):
    """Return the `Reflection`s of a peer-review activity."""
    task = tasks.get(REFLECT_TASK)
    if not task:
        return []
    reflections = fbf.get(related_link(task, "reflections")).resources
    users = fbf.get_by_ids("v1/users", [related_id(r, "user")
                                        for r in reflections])
    return make_reflections(activity, reflections, users)


def make_reflections(activity, reflections, users):
    """Return the `Reflection`s, sorted by student."""
    return sorted((Reflection(activity,
                              name_of(users, related_id(r, "user")),
                              plain_text(attribute(r, "body")))
                   for r in reflections),
                  key=lambda reflection: reflection.student)
