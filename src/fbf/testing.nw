import pytest

@pytest.mark.vcr
def test_uses_fbf(fbf):
  pass
"""

def test_a_rewrite_without_credentials_keeps_the_cassettes(
    pytester, monkeypatch):
  monkeypatch.setenv("TEST_PSEUDONYM_KEY", "a key for the inner run")
  make_inner_conftest(pytester, monkeypatch)
  pytester.makepyfile(test_inner=REWRITE_TESTS)
  cassette = pytester.path / "cassettes" / "test_inner" / "test_uses_fbf.yaml"
  write_interaction(cassette, "https://api.example.com/v1/users/current")
  result = pytester.runpytest_inprocess(
    "--record-mode=rewrite", "-p", "no:cacheprovider")
  assert result.ret == 1
  result.stdout.fnmatch_lines(["*cannot launch FBF, so nothing is recorded*"])
  assert os.environ["FBF_INNER_ASKED_FOR_CREDENTIALS"] == "yes"
