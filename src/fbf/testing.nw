  result.assert_outcomes(passed=1)
  assert result.ret == 1
  result.stdout.fnmatch_lines(["*PRIVACY*", "*jwt*"])

def test_drift_fails_a_live_run(
    pytester, local_service, monkeypatch, tmp_path):
  monkeypatch.setenv("FBF_TEST_PATH", "/data")
  make_inner_conftest(pytester, monkeypatch)
  pytester.makepyfile(test_inner=RECORDING_TESTS)
  write_interaction(pytester.path / "cassettes" / "test_inner"
                    / "test_fetch.yaml", local_service + "/data",
                    json.dumps({"kept": 1}), "application/json")
  result = pytester.runpytest_inprocess(
    "--live", f"--live-dir={tmp_path / 'live'}", "-p", "no:cacheprovider")
  result.assert_outcomes(passed=1)
  assert result.ret == 1
  result.stdout.fnmatch_lines(["*drift*removed $.kept*", "*DRIFT*"])
