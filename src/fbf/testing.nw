A recorded cookie must survive in replay however long after the recording
the replay runs.
We record two cookies that, seen from now, have long expired, in both ways a
service can say so, and check that a [[requests]] cookie jar given the
recorded headers keeps both.
<<test functions>>=
def test_replayed_cookies_do_not_expire(scrubber):
  import http.client
  import requests
  response = scrubber.before_record_response(recorded_response(
    "", **{"Set-Cookie": [
      "access_token=eyJabc; Expires=Thu, 01 Jan 2004 00:00:00 GMT; path=/",
      "refresh_token=def; Max-Age=-1; Path=/; secure"]}))
  cookies = response["headers"]["Set-Cookie"]
  assert cookies == ["access_token=redacted; path=/",
                     "refresh_token=redacted; Path=/; secure"]
  message = http.client.HTTPMessage()
  for cookie in cookies:
    message["Set-Cookie"] = cookie
  jar = requests.cookies.RequestsCookieJar()
  jar.extract_cookies(
    requests.cookies.MockResponse(message),
    requests.cookies.MockRequest(
      requests.Request("GET", "https://api.example.com/").prepare()))
  assert {cookie.name for cookie in jar} == {"access_token", "refresh_token"}
@

