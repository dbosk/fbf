]}

def test_scrubbing_leaves_its_own_output_alone(tmp_path):
  originals = tmp_path / "originals.txt"
  first = conftest.FBFPseudonymizer(b"a key for the tests", originals)
  once = first.scrub_json(json.loads(json.dumps(SCRUBBED_TWICE)))
  noted = originals.read_text()
  second = conftest.FBFPseudonymizer(b"a key for the tests", originals)
  twice = second.scrub_json(json.loads(json.dumps(once)))
  assert twice == once
  assert originals.read_text() == noted
