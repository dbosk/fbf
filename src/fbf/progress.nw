    print(f"{assignment.name}: {len(actors) - len(student_of)} FBF "
          "participants are not students in Canvas, left out",
          file=sys.stderr)
<<warn about progresses set aside>>
graded = [row for row in rows if row.overall is not None]
unexplained = sum(1 for row in graded
                  if not adds_up(row.facets, row.overall))
if unexplained:
    print(f"{assignment.name}: {unexplained} of {len(graded)} breakdowns "
          "do not add up to the overall grade; FeedbackFruits may have "
          "changed how it grades", file=sys.stderr)
