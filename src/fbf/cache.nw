def test_tokens_round_trip_through_the_keyring(memory_keyring):
  assert stored_login("canvas.example") is None
  store_login("canvas.example", FBFLogin("a", "r", "https://api.example"))
  login = stored_login("canvas.example")
  assert (login.access_token, login.refresh_token, login.api_url) \
    == ("a", "r", "https://api.example")
  keyring.set_keyring(BrokenKeyring())
  store_login("canvas.example", login)
  assert stored_login("canvas.example") is None
