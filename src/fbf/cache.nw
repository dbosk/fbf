<<imports>>=
import urllib.parse
<<functions>>=
def relative(path):
    """Return the path of `path` after the host, and its query."""
    parts = urllib.parse.urlsplit(path)
    return parts.path.lstrip("/"), dict(urllib.parse.parse_qsl(parts.query))


def policy_of(path):
    """Return the `Policy` for `path`, or `None` if it is not cached."""
    path, _ = relative(path)
    return next((policy for policy in POLICIES
                 if re.search(policy.pattern, path)), None)
@

Let's verify the classes on paths as the fetchers send them: the lists are
short-lived, the details long-lived, and a path we never classified is not
cached.

