The annotations join a post to its fragment.
We index them by the child's id, since we look them up from the post.

<<functions>>=
def anchors(annotations, fragments):
    """Map post ids to their fragments through the `annotations`."""
    by_id = {fragment["id"]: fragment for fragment in fragments}
    return {related_id(annotation, "child"):
            by_id.get(related_id(annotation, "parent"))
            for annotation in annotations}
@

<<test functions>>=
def test_anchors_join_posts_to_fragments():
  fragment = {"type": "video-fragments", "id": "f"}
  annotation = {"type": "annotations", "id": "n", "relationships": {
    "child": {"data": {"type": "comments", "id": "c"}},
    "parent": {"data": {"type": "video-fragments", "id": "f"}}}}
  assert anchors([annotation], [fragment]) == {"c": fragment}
