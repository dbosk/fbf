USERS = {"u1": {"type": "users", "id": "u1",
                "attributes": {"name": "Ada Student"}}}

def test_make_post_kinds_and_author():
  answer = make_post(resource("open-answers", "a", score=1.0), USERS)
  assert (answer.kind, answer.author, answer.score) \
    == ("answer", "Ada Student", 1.0)
  reply = make_post(resource("comments", "c", user="gone"), USERS, reply=True)
  assert (reply.kind, reply.author) == ("reply", "")

def test_make_post_choice_answer_uses_choices():
  answer = {"type": "scratch-off-answers", "id": "a",
            "attributes": {"created-at": "t", "score": 0.5,
                           "comments-count": 0},
            "relationships": {
              "user": {"data": {"type": "users", "id": "u1"}},
              "choices": {"data": [{"type": "questions/choice", "id": "k1"},
                                   {"type": "questions/choice", "id": "k2"}]}}}
  choices = {"k1": {"type": "questions/choice", "id": "k1",
                    "attributes": {"body": "Yes"}}}
  post = make_post(answer, USERS, choices=choices)
  assert (post.kind, post.body, post.upvotes, post.score) \
    == ("answer", "Yes", 0, 0.5)

def test_post_count_counts_all_descendants():
  leaf = Post("reply", "", "", "")
  post = Post("comment", "", "", "", replies=[Post("reply", "", "", "",
                                                   replies=[leaf]), leaf])
  assert post.count() == 3
