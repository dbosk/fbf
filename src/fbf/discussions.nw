\section{Where a thread sits}

A video position reads best as minutes and seconds, the way the player shows
it.
A document region has no such convention---its coordinates are FBF's
internal ones---so we print the corners rounded, enough to sort threads and
to find them again.
Other fragment types we print by type, so that a new tool shows up instead
of crashing.

<<functions>>=
def position(fragment):
    """Return a readable position for a video or document `fragment`."""
    if fragment is None:
        return ""
    if fragment["type"] == "video-fragments":
        return (f"{clock(attribute(fragment, 'time-min'))}"
                f"--{clock(attribute(fragment, 'time-max'))}")
    if fragment["type"] == "document-fragments":
        corners = [attribute(fragment, name)
                   for name in ("x-min", "y-min", "x-max", "y-max")]
        return "({:.2f},{:.2f})--({:.2f},{:.2f})".format(*corners)
    return fragment["type"]


def clock(seconds):
    """Return `seconds` as `m:ss`."""
    minutes, seconds = divmod(int(round(seconds or 0)), 60)
    return f"{minutes}:{seconds:02d}"
@

<<test functions>>=
def test_position():
  video = {"type": "video-fragments",
           "attributes": {"time-min": 62.4, "time-max": 70}}
  document = {"type": "document-fragments",
              "attributes": {"x-min": 0.1, "y-min": 1.234,
                             "x-max": 0.5, "y-max": 1.3}}
  assert position(video) == "1:02--1:10"
  assert position(document) == "(0.10,1.23)--(0.50,1.30)"
  assert position({"type": "audio-fragments"}) == "audio-fragments"
  assert position(None) == ""
