<<test functions>>=
from canvasapi.assignment import Assignment as CanvasAssignment
from canvasapi.user import User

def fbf_assignment(id, code):
  url = f"https://api.feedbackfruits.com/v1/lti/launch?code={code}"
  return CanvasAssignment(None, {
    "id": id, "course_id": 5, "name": f"Week {id}", "points_possible": 10,
    "external_tool_tag_attributes": {"url": url}})

class Course:
  def __init__(self, assignments, users):
    self.assignments, self.users = assignments, users
  def get_assignments(self, **params):
    return self.assignments
  def get_users(self, **params):
    return self.users

def ada():
  return User(None, {"id": 2, "name": "Ada", "login_id": "ada",
                     "email": "ada@uni.example",
                     "enrollments": [{"type": "StudentEnrollment"}]})

def test_viewer_gives_every_part_and_launches_once(media_server, tmp_path):
  fbf = world(media_server)
  opened, unopened = fbf_assignment(1, "opened"), fbf_assignment(2, "new")
  course = Course([opened, unopened], [ada()])
  launches = []
  viewer = Viewer(SimpleNamespace(get_course=lambda id: course), None, None,
                  connect=lambda assignments: launches.append(1) or fbf)
  sections = viewer.sections(
    SimpleNamespace(assignment=opened, user_id=2, score=8.0), tmp_path)
  assert [s.title for s in sections] == [
    WORK_TITLE, GRADE_TITLE, RECEIVED_TITLE, GIVEN_TITLE, REFLECTION_TITLE]
  work = sections[0]
  assert [f.name for f in work.files] == ["lab.py"]
  assert work.body == "- lab (document, 2026-10-01T10:00Z)"
  assert "- Overall: 80 %, 8 of 10 points" in sections[1].body
  assert viewer.sections(SimpleNamespace(assignment=unopened, user_id=2,
                                         score=None), tmp_path) \
    == [Section(WORK_TITLE, NOT_OPENED)]
  assert launches == [1]
