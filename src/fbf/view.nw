from canvasapi.assignment import Assignment as CanvasAssignment
from canvasapi.user import User

def fbf_assignment(id, code):
  url = f"https://api.feedbackfruits.com/v1/lti/launch?code={code}"
  return CanvasAssignment(None, {
    "id": id, "course_id": 5, "name": f"Week {id}", "points_possible": 10,
    "external_tool_tag_attributes": {"url": url}})

class Course:
  def __init__(self, assignments, users):
    self.assignments, self.users = assignments, users
  def get_assignments(self, **params):
    return self.assignments
  def get_users(self, **params):
    return self.users

def canvas_student(id, name, email):
  return User(None, {"id": id, "name": name, "login_id": name.lower(),
                     "email": email,
                     "enrollments": [{"type": "StudentEnrollment"}]})

STUDENTS = [canvas_student(2, "Ada", "ada@uni.example"),
            canvas_student(1, "Bo", "bo@uni.example"),
            canvas_student(3, "Cy Student", "cy@uni.example")]

class LoggingFBF(FakeFBF):
  """The fake client, also logging the ids of each request by id."""
  def get_by_ids(self, path, ids):
    self.asked_ids = getattr(self, "asked_ids", []) + [(path, set(ids))]
    return super().get_by_ids(path, ids)

def viewer_of(fbf, launches=None):
  opened, unopened = fbf_assignment(1, "opened"), fbf_assignment(2, "new")
  course = Course([opened, unopened], STUDENTS)
  def connect(assignments):
    if launches is not None:
      launches.append(1)
    return fbf
  viewer = Viewer(SimpleNamespace(get_course=lambda id: course), None, None,
                  connect=connect)
  return viewer, opened, unopened

def view(viewer, assignment, user_id, workdir, score=None):
  return viewer.sections(SimpleNamespace(assignment=assignment,
                                         user_id=user_id, score=score),
                         workdir)

def test_viewer_gives_every_part_and_launches_once(media_server, tmp_path):
  fbf = world(media_server)
  launches = []
  viewer, opened, unopened = viewer_of(fbf, launches)
  sections = view(viewer, opened, 2, tmp_path, score=8.0)
  assert [s.title for s in sections] == [
    WORK_TITLE, GRADE_TITLE, RECEIVED_TITLE, GIVEN_TITLE, REFLECTION_TITLE]
  work, grade = sections[0], sections[1]
  assert [f.name for f in work.files] == ["lab.py"]
  assert work.body.splitlines() == [
    f"- lab (document, 2026-09-30T10:00Z): {NO_FILE}",
    "- lab (document, 2026-10-01T10:00Z)"]
  assert "- Overall: 80 %, 8 of 10 points" in grade.body
  assert "- In Canvas: 8 points" in grade.body
  assert view(viewer, unopened, 2, tmp_path) \
    == [Section(WORK_TITLE, NOT_OPENED)]
  assert launches == [1]
