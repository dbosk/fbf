Last, the run after: a second viewer, as in the next run of the command,
must find the tokens in the keyring and everything else in the cache file,
and ask FBF for nothing, as long as the lists are younger than five
minutes.
Here the client must be the real [[FBF]], since the cache is in its [[get]],
so we serve the fake world over a local web server (rung~2), the media
server above extended with the API.
The world's links are shortened for the review tests (\cref{fake-fbf});
we give them FBF's real shapes, since the cache's policies go by them.
The file is downloaded again, as the attachment cache has no key in the
tests; everything else must come from the cache.

<<test functions>>=
import re
import urllib.parse
from fbf.launch import FBFLogin

class FBFHandler(MediaHandler):
  def do_GET(self):
    parts = urllib.parse.urlsplit(self.path)
    self.server.asked.append(parts.path)
    query = dict(urllib.parse.parse_qsl(parts.query))
    world = self.server.world
    for path in (parts.path.lstrip("/"), parts.path):
      if "filter[id]" in query and path in world.by_id:
        ids = query["filter[id]"].split(",")
        return self.reply(200, json.dumps({"data": [
          resource for id, resource in world.by_id[path].items()
          if id in ids]}).encode())
      if path in world.documents:
        return self.reply(200, json.dumps(world.documents[path]).encode())
    super().do_GET()

@pytest.fixture
def fbf_server():
  server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), FBFHandler)
  server.asked = []
  thread = threading.Thread(target=server.serve_forever, daemon=True)
  thread.start()
  yield server, f"http://127.0.0.1:{server.server_address[1]}"
  server.shutdown()
  server.server_close()

LIST_NAMES = {"r": "reviews", "s": "ratings", "f": "reviewer_feedbacks"}

def real_link(text):
  text = re.sub(r"^/([rsf])/(a\d+)$", lambda m:
                f"/v1/assignments/allocations/{m[2]}/{LIST_NAMES[m[1]]}",
                text)
  return re.sub(r"^/(t\d)/(\w+)$", r"/v1/assignments/tasks/\1/\2", text)

def real_links(value):
  if isinstance(value, dict):
    return {key: real_links(item) for key, item in value.items()}
  if isinstance(value, list):
    return [real_links(item) for item in value]
  return real_link(value) if isinstance(value, str) else value

def real_world(url):
  """The world of the viewer's tests, with FBF's real link shapes."""
  served = world(url)
  served.documents = {real_link(path): real_links(document)
                      for path, document in served.documents.items()}
  for progress in served.documents["v1/progresses"]["data"]:
    served.documents[f"v1/progresses/{progress['id']}"] = {"data": progress}
  for allocation in served.documents[
      "/v1/assignments/tasks/t1/allocations"]["data"]:
    served.documents[f"v1/assignments/allocations/{allocation['id']}"] = \
      {"data": allocation}
  return served

def test_a_second_run_needs_no_launch_and_no_request(fbf_server, tmp_path,
                                                     memory_keyring,
                                                     personal_data_allowed):
  server, url = fbf_server
  server.world = real_world(url)
  launches = []
  def connect(assignments):
    launches.append(1)
    return FBF(FBFLogin("access", "refresh", url, course_uuid="c"))
  opened = fbf_assignment(1, "opened")
  canvas = SimpleNamespace(get_course=lambda id: Course([opened], STUDENTS))
  def run(workdir):
    viewer = Viewer(canvas, "canvas.example", "token", connect=connect,
                    cache_path=tmp_path / "fbf.cache")
    sections = view(viewer, opened, 2, workdir, score=8.0)
    viewer.close()
    return [(section.title, section.body) for section in sections]
  first = run(tmp_path / "first")
  assert cache_module.stored_login("canvas.example").refresh_token \
    == "refresh"
  server.asked.clear()
  assert run(tmp_path / "second") == first
  assert launches == [1]
  assert [path for path in server.asked
          if path != "/m1/lab.py" and not path.startswith("/blob/")] == []
