from types import SimpleNamespace
from test_reviews import FakeFBF, user

def emails_document(*addresses):
  return {"data": [{"type": "emails", "id": f"e{n}",
                    "attributes": {"address": address}}
                   for n, address in enumerate(addresses)]}

PEOPLE = {"v1/people/u1/emails": emails_document("bo@uni.example"),
          "v1/people/u2/emails": emails_document("ADA@uni.example"),
          "v1/people/u3/emails": emails_document("cy@uni.example")}
NAMED = {"u1": user("u1", "Robert B"), "u2": user("u2", "Ada  Lovelace"),
         "u3": user("u3", "Cy")}

def student(id, name, email):
  return SimpleNamespace(id=id, name=name, email=email, login_id=None)

def test_student_users_asks_the_namesakes_first():
  fbf = FakeFBF(PEOPLE, {})
  ada = student(2, "Ada Lovelace", "ada@uni.example")
  assert student_users(fbf, NAMED, ada, {}) == {"u2"}
  assert fbf.asked == ["v1/people/u2/emails"]

def test_student_users_falls_back_to_everyone_by_address():
  fbf = FakeFBF(PEOPLE, {})
  bo = student(1, "Bo Berg", "bo@uni.example")
  assert student_users(fbf, NAMED, bo, {}) == {"u1"}
  assert sorted(fbf.asked) == ["v1/people/u1/emails", "v1/people/u2/emails",
                               "v1/people/u3/emails"]
  assert student_users(fbf, NAMED, student(9, "Di", "di@uni.example"),
                       {}) == set()
