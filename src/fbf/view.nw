Stored tokens may have run out.
Then the client's renewal tries the refresh token, which FBF refuses, and
launches again through the course's safest assignment; the new tokens are
the ones kept for the next run.
The server refuses the old token and the refresh, and the launch is a
stand-in, since a real one needs Canvas.

<<test functions>>=
class StrictFBFHandler(FBFHandler):
  def do_GET(self):
    if self.headers.get("Authorization") == "Bearer old":
      return self.reply(401, b"expired")
    super().do_GET()
  def do_POST(self):
    self.reply(401, b"refresh refused")

def test_expired_stored_tokens_are_renewed_by_a_launch(tmp_path,
                                                      memory_keyring,
                                                      personal_data_allowed):
  server = http.server.ThreadingHTTPServer(("127.0.0.1", 0),
                                           StrictFBFHandler)
  server.asked = []
  threading.Thread(target=server.serve_forever, daemon=True).start()
  url = f"http://127.0.0.1:{server.server_address[1]}"
  try:
    server.world = real_world(url)
    opened = fbf_assignment(1, "opened")
    canvas = SimpleNamespace(get_course=lambda id: Course([opened], STUDENTS))
    cache_module.save_cache(cache_module.Cache(courses={"5": "c"}),
                            "canvas.example", "token", tmp_path / "fbf.cache")
    cache_module.store_login("canvas.example", FBFLogin("old", "old", url))
    relaunches = []
    def relaunch(canvas_url, canvas_token, course_id, assignment_id):
      relaunches.append((course_id, assignment_id))
      return FBFLogin("new", "new", url, course_uuid="c")
    viewer = Viewer(canvas, "canvas.example", "token",
                    connect=lambda assignments: pytest.fail("launched"),
                    cache_path=tmp_path / "fbf.cache", relaunch=relaunch)
    titles = [s.title for s in view(viewer, opened, 2, tmp_path / "w")]
    viewer.close()
  finally:
    server.shutdown()
    server.server_close()
  assert titles[:2] == [WORK_TITLE, GRADE_TITLE]
  assert relaunches == [(5, 1)]
  assert cache_module.stored_login("canvas.example").access_token == "new"
