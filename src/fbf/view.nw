The section lists the student's items, oldest first, and downloads their
files.
The list says what each item is and when it came, which matters when there
are several; the files follow it, converted by [[canvaslms]].

<<functions>>=
def work_section(activity, users, workdir):
    """Return the `Section` of the work that `users` handed in."""
    items = sorted((item for item in activity.submissions
                    if related_id(item, "user") in users),
                   key=lambda item: attribute(item, "created-at"))
    if not items:
        return Section(WORK_TITLE, "Nothing handed in.")
    base = media_base(activity.fbf.login.api_url)
    lines, files, taken = [], [], set()
    for item in items:
        media = related_id(item, "media")
        path = media and download_media(activity.fbf.session, base, media,
                                        workdir, taken,
                                        getattr(activity.fbf, "cache", None))
        line = (f"- {attribute(item, 'title')} "
                f"({attribute(item, 'category')}, "
                f"{attribute(item, 'created-at')})")
        lines.append(line if path else f"{line}: {NO_FILE}")
        if path:
            files.append(path)
    return Section(WORK_TITLE, "\n".join(lines), files)
