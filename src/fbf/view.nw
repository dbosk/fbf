import requests

def test_download_media_follows_the_redirect_and_numbers_copies(
    media_server, tmp_path):
  session = requests.Session()
  first = download_media(session, media_server, "m1", tmp_path / "work")
  second = download_media(session, media_server, "m1", tmp_path / "work")
  assert first.name == "lab.py" and second.name == "lab (2).py"
  assert second.read_text() == "print('hello')\n"
  assert download_media(session, media_server, "m2", tmp_path) is None
  with pytest.raises(APIError) as error:
    download_media(session, media_server, "m3", tmp_path)
  assert error.value.status == 404 and "sig" not in str(error.value)

def test_media_base_swaps_the_api_host_only():
  assert media_base("https://api.eu.feedbackfruits.com") \
    == "https://media.eu.feedbackfruits.com"
  assert media_base("http://127.0.0.1:8000") == "http://127.0.0.1:8000"
