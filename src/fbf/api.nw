Renewal on a [[401]] happens when the access token expires, after 30
minutes.
No test should wait that long, and a recording cannot make FBF refuse a
token, so we inject the refusal: a session whose first request gets a
[[401]] without reaching FBF.
Everything after it is real: the refresh at [[/oauth/token]] and the
repeated request go to FBF, or to the recording.
We check the requests at the boundary, the session, since the renewal is
visible nowhere else: in replay the old and the new tokens are the same
placeholder.
<<test functions>>=
class FirstRequestUnauthorized(requests.Session):
  """A session whose first request gets 401, as with an expired token."""

  def __init__(self):
    super().__init__()
    self.sent = []

  def request(self, method, url, *args, **kwargs):
    self.sent.append((method, urllib.parse.urlsplit(url).path))
    if len(self.sent) == 1:
      response = requests.Response()
      response.status_code = 401
      response.url = url
      return response
    return super().request(method, url, *args, **kwargs)

@pytest.mark.vcr
def test_request_renews_the_tokens_on_401(fbf):
  session = FirstRequestUnauthorized()
  client = FBF(fbf.login, session=session)
  document = client.get("v1/users/current")
  assert document.resource["type"] == "users"
  assert session.sent == [("GET", "/v1/users/current"),
                          ("POST", TOKEN_PATH),
                          ("GET", "/v1/users/current")]
@
